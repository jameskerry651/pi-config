# ============================================================
# pi config repo — ignore rules
# Repo root is ~/.pi/agent (the live config dir).
# Only portable config is tracked; secrets/runtime are excluded.
# ============================================================

# ❌ Secrets — NEVER commit
# auth.json holds your provider API keys (DeepSeek, etc.). Keep it local.
auth.json

# Ephemeral runtime state (session history, logs) — huge & machine-specific
sessions/
bin/
*.log

# Update-check cache — rewritten by pi, machine-specific timestamps
pi-web-update-check.json

# Dependencies — rebuilt via `npm install`.
# node_modules/ matches at any depth (npm/node_modules, extensions/browser/node_modules)
node_modules/

# Browser extension profile — cookies, login state, cache
extensions/browser/.profile/

# Machine-specific: absolute local filesystem paths (not portable)
trust.json

# Machine-specific symlinks — point to personal projects at absolute paths
# (dangle on another machine). Source lives in those projects, not here.
extensions/pimail
skills/training-monitor

# Local runtime data for the pimail extension (mail account config + log)
/pimail/

# Bark deviceKey sits in config.json — keep it local, use PI_BARK_WATCH_KEY env on
# each machine instead of committing a key.
extensions/pi-bark-watch/config.json

# OS junk
.DS_Store
Thumbs.db

# Python bytecode (imessage-cleanup scan script)
__pycache__/
*.pyc
